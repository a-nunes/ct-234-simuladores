# Supply-chain hardening
# Só instala versões publicadas há pelo menos 14 dias (janela para detecção de pacotes comprometidos).
min-release-age=14
# Scripts de instalação (postinstall etc.) não revisados em "allowScripts" fazem a instalação falhar.
strict-allow-scripts=true
# Versões exatas no package.json; o lockfile continua sendo a fonte da verdade.
save-exact=true
audit-level=low
fund=false
