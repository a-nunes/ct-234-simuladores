{
  "name": "ct-234-simuladores",
  "version": "1.1.0",
  "description": "Plataforma interativa de visualização de algoritmos para o ITA",
  "author": "Instituto Tecnológico de Aeronáutica (ITA)",
  "license": "MIT",
  "keywords": [
    "algorithms",
    "visualization",
    "education",
    "ITA",
    "graph-algorithms",
    "string-matching",
    "interactive",
    "simulator"
  ],
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit -p .",
    "build": "tsc --noEmit -p . && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit": "npm audit --audit-level=low"
  },
  "dependencies": {
    "lucide-react": "1.67.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "allowScripts": {
    "fsevents": false
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "autoprefixer": "10.6.2",
    "jsdom": "30.1.3",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
